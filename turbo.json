// turbo.json — how monorepo tasks run and what they produce.
// Why: one command (`pnpm test`, `pnpm build`, …) runs the task in every package,
// in dependency order, with caching. How it connects: package.json scripts call
// `turbo run <task>`; each workspace package defines its own script of that name.
{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".output/**", "dist/**"] },
    "lint": {},
    "type-check": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "dev": { "cache": false, "persistent": true }
  }
}
