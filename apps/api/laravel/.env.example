# .env.example — the settings the Laravel app reads from .env, with safe example values.
# Why: secrets and per-machine settings live only in .env (never in git; CLAUDE.md).
# Copy this file to .env, then run `php artisan key:generate`.
# How it connects: Laravel loads .env at startup; the server's own .env lives in
# shared/.env (phase-1 §10). Later checkpoints add the CHAPELCORE_* settings.

APP_NAME=ChapelCore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The development database (the tests use chapelcore_test; see phpunit.xml).
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chapelcore
DB_USERNAME=chapelcore
DB_PASSWORD=
