# .env.example — the settings the Laravel app reads from .env, with safe example values.
# Why: secrets and per-machine settings live only in .env (never in git; CLAUDE.md).
# Copy this file to .env, then run `php artisan key:generate`.
# How it connects: Laravel loads .env at startup; the server's own .env lives in
# shared/.env (phase-1 §10). config/chapelcore.php reads the CHAPELCORE_* settings.

APP_NAME=ChapelCore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The development database (the tests use chapelcore_test; see phpunit.xml). Creating
# both: docs/runbooks/development.md §6.2.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chapelcore_dev
DB_USERNAME=chapelcore_dev
DB_PASSWORD=

# The cache, including the rate limiter's counts, lives in the database (no Redis on
# shared hosting); `php artisan migrate` creates its table.
CACHE_STORE=database

# Where the API's paths start (PLAN D16). Empty when the API has its own host name, as at
# Libby: api.libbynaz.org/health, and localhost:8000/health on your machine. "api" when the
# site and the API share one domain: example.org/api/health.
CHAPELCORE_API_PREFIX=

# Where version.json is. Leave unset to use the repository's own (three folders up).
# CHAPELCORE_VERSION_PATH=

# Browser origins allowed to call the API, comma-separated and exact
# (e.g. https://test.libbynaz.org). Leave empty when the site and the API share a domain
# (the /api layout). "*" is never accepted.
CHAPELCORE_CORS_ORIGINS=

# Proxies whose X-Forwarded-For is believed, comma-separated (addresses or ranges).
# Leave empty unless a proxy or CDN sits in front of the API.
CHAPELCORE_TRUSTED_PROXIES=

# Which environment this is, for `php artisan chapelcore:doctor`: dev, test or production.
# Outside dev, the doctor also checks that APP_URL is https://, that debug is off in
# production, and how long each certificate in CHAPELCORE_TLS_HOSTS has left.
CHAPELCORE_ENV=dev

# Hosts whose TLS certificates the doctor checks, comma-separated, as host or host:port
# (e.g. libbynaz.org, api.libbynaz.org). Leave empty in dev.
CHAPELCORE_TLS_HOSTS=
