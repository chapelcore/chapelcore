{
  "name": "chapelcore/api-laravel",
  "description": "ChapelCore API on Laravel: a thin adapter over the PHP core (libs/php/native/core). It wires routes, HTTP, storage and configuration to the core, which holds every rule; the tests check its responses against the contract (libs/shared/contract). Both are local path packages pinned to the DOMAIN-MODEL version they implement.",
  "type": "project",
  "repositories": [
    {
      "type": "path",
      "url": "../../../libs/php/native/core",
      "options": {
        "symlink": true,
        "reference": "config",
        "versions": {
          "chapelcore/core": "0.4.0"
        }
      }
    },
    {
      "type": "path",
      "url": "../../../libs/shared/contract",
      "options": {
        "symlink": true,
        "reference": "config",
        "versions": {
          "chapelcore/contract": "0.4.0"
        }
      }
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-mbstring": "*",
    "ext-pdo_mysql": "*",
    "chapelcore/core": "0.4.0",
    "laravel/framework": "13.42.0"
  },
  "require-dev": {
    "chapelcore/contract": "0.4.0",
    "larastan/larastan": "3.13.2",
    "laravel/pint": "1.32.1",
    "phpstan/phpstan": "2.3.4",
    "phpunit/phpunit": "13.4.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ],
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "format": "pint",
    "format:check": "pint --test"
  },
  "config": {
    "allow-plugins": {},
    "optimize-autoloader": true,
    "platform": {
      "php": "8.4.1"
    },
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
