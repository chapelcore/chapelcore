// tsconfig.json — TypeScript settings for the web, generated by Nuxt.
// Why: Nuxt writes one tsconfig per context (app, server, shared, node) into .nuxt/ with
// its auto-imports and aliases; this file only points to them (Nuxt 4 convention).
// How it connects: `nuxt typecheck` (vue-tsc) and ESLint's project service read it;
// `nuxt prepare` (postinstall) writes .nuxt/.
{
  "files": [],
  "references": [
    { "path": "./.nuxt/tsconfig.app.json" },
    { "path": "./.nuxt/tsconfig.server.json" },
    { "path": "./.nuxt/tsconfig.shared.json" },
    { "path": "./.nuxt/tsconfig.node.json" }
  ]
}
