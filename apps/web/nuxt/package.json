    "@types/node": "24.19.2",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  }
