# .env.example — the web's build settings. Copy it to .env (never committed) to change them.
# Why: a static build bakes these in (phase-1.md §6.5 E2). Without a value, `nuxt dev` and the
# tests use the local API at http://localhost:8000, and `nuxt generate` stops.
# How it connects: Nuxt loads .env; nuxt.config.ts reads it through build-settings.ts.

# {apiBase}: https://api.example.org, or a path such as /api in the same-domain layout
CHAPELCORE_API_BASE=http://localhost:8000

# the church's name on the placeholder page; ChapelCore when empty
CHAPELCORE_SITE_NAME=
