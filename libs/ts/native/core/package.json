{
  "name": "@chapelcore/core",
  "private": true,
  "description": "ChapelCore TypeScript core: types generated from the contract, the API client, redaction and client error reports. Plain TypeScript with no framework and no run-time dependencies; the admin and site (1.7) import it. Built to dist/ by tsc (phase-1.md §6.4).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "node scripts/generate-types.ts",
    "type-check": "tsc -p tsconfig.build.json --noEmit && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@chapelcore/contract": "workspace:*",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
