// tsconfig.json — TypeScript settings for the TS core's source and tests (type-check only).
// Why: CLAUDE.md requires a `strict` tsconfig and ESM for plain TypeScript; these are the
// contract's settings, plus the browser's types, since the core runs in the admin and site.
// How it connects: `tsc --noEmit` (pnpm type-check, CI static-analysis) and the ESLint
// project service read it. tsconfig.build.json extends it to build src/ alone, without
// Node's types.
{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024", "dom"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
