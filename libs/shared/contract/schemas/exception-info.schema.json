{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chapelcore.org/contract/schemas/exception-info.schema.json",
  "title": "ExceptionInfo",
  "description": "DOMAIN-MODEL \u00a75.8: an exception as written to the log; never sent in a response.",
  "type": "object",
  "required": ["type", "message", "file", "line", "trace", "previous"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "file": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "line": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "previous": {
      "anyOf": [
        {
          "$ref": "#"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
