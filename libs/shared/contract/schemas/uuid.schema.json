{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chapelcore.org/contract/schemas/uuid.schema.json",
  "title": "Uuid",
  "description": "DOMAIN-MODEL \u00a72: an RFC 9562 UUID, lowercase and hyphenated.",
  "type": "string",
  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
}
