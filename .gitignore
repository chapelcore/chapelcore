# .gitignore — files git must never track.
# Why: dependencies, build output, test reports and local secrets are generated or private.

# Dependencies
node_modules/
vendor/
.pnpm-store/

# Build output
.output/
.nuxt/
.nitro/
dist/
.turbo/
*.tsbuildinfo

# Tests
coverage/
.phpunit.cache/
playwright-report/
test-results/
blob-report/

# Environment and secrets (examples are tracked)
.env
.env.*
!.env.example

# Logs
*.log

# Editors and OS
.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
