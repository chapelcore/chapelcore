{
  "name": "chapelcore",
  "private": true,
  "description": "ChapelCore monorepo root: shared scripts and tools; apps and libraries are pnpm workspace packages.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "check:pins": "node scripts/check-pins.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.9"
  }
}
